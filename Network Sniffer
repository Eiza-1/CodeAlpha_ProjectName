class PacketAnalyzer:
    def __init__(self):
        self.packet_count = 0
        self.protocol_stats = defaultdict(int)
        self.traffic_stats = {
            'total_packets': 0,
            'total_bytes': 0,
            'start_time': datetime.now()
        }
    
    def analyze_scapy_packet(self, packet):
        """Analyze packet using Scapy library"""
        try:
            # Basic packet information
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            
            # Extract Ethernet layer info
            if Ether in packet:
                eth_info = f"Ethernet: {packet[Ether].src} -> {packet[Ether].dst}"
            else:
                eth_info = "No Ethernet layer"
            
            # Extract IP layer info
            if IP in packet:
                ip_layer = packet[IP]
                src_ip = ip_layer.src
                dst_ip = ip_layer.dst
                protocol = ip_layer.proto
                ttl = ip_layer.ttl
                
                # Protocol identification
                proto_name = self.get_protocol_name(protocol)
                self.protocol_stats[proto_name] += 1
                
                # Extract transport layer info
                port_info = ""
                if TCP in packet:
                    tcp_layer = packet[TCP]
                    port_info = f"TCP: {tcp_layer.sport} -> {tcp_layer.dport}"
                    flags = self.get_tcp_flags(tcp_layer.flags)
                elif UDP in packet:
                    udp_layer = packet[UDP]
                    port_info = f"UDP: {udp_layer.sport} -> {udp_layer.dport}"
                elif ICMP in packet:
                    icmp_layer = packet[ICMP]
                    port_info = f"ICMP: Type {icmp_layer.type}, Code {icmp_layer.code}"
                
                # Extract payload if exists
                payload_size = len(packet)
                payload_data = ""
                if Raw in packet:
                    raw_data = packet[Raw].load
                    payload_data = f"Payload ({len(raw_data)} bytes): {raw_data[:50]}..."
                
                # Update statistics
                self.traffic_stats['total_packets'] += 1
                self.traffic_stats['total_bytes'] += len(packet)
                
                # Display packet information
                print(f"\n[{timestamp}] Packet #{self.traffic_stats['total_packets']}")
                print(f"  {eth_info}")
                print(f"  IP: {src_ip} -> {dst_ip} (TTL: {ttl})")
                print(f"  Protocol: {proto_name} ({protocol})")
                print(f"  Transport: {port_info}")
                if TCP in packet:
                    print(f"  TCP Flags: {flags}")
                if payload_data:
                    print(f"  {payload_data}")
                    
            else:
                print(f"[{timestamp}] Non-IP Packet: {type(packet)}")
                
        except Exception as e:
            print(f"Error analyzing packet: {e}")
    
    def get_protocol_name(self, protocol_num):
        """Convert protocol number to name"""
        protocols = {
            1: "ICMP",
            6: "TCP",
            17: "UDP",
            2: "IGMP",
            89: "OSPF"
        }
        return protocols.get(protocol_num, f"Unknown({protocol_num})")
    
    def get_tcp_flags(self, flags):
        """Convert TCP flags to readable format"""
        flag_names = {
            'F': 'FIN',
            'S': 'SYN', 
            'R': 'RST',
            'P': 'PSH',
            'A': 'ACK',
            'U': 'URG',
            'E': 'ECE',
            'C': 'CWR'
        }
        flag_str = ""
        for char in flags:
            if char in flag_names:
                flag_str += flag_names[char] + " "
        return flag_str.strip() if flag_str else "None"
    
    def print_statistics(self):
        """Print traffic statistics"""
        duration = datetime.now() - self.traffic_stats['start_time']
        print(f"\n{'='*50}")
        print(f"TRAFFIC STATISTICS (Duration: {duration})")
        print(f"{'='*50}")
        print(f"Total Packets: {self.traffic_stats['total_packets']}")
        print(f"Total Bytes: {self.traffic_stats['total_bytes']:,}")
        print(f"Packets per second: {self.traffic_stats['total_packets']/duration.total_seconds():.2f}")
        print("\nProtocol Distribution:")
        for proto, count in sorted(self.protocol_stats.items(), key=lambda x: x[1], reverse=True):
            percentage = (count / self.traffic_stats['total_packets']) * 100 if self.traffic_stats['total_packets'] > 0 else 0
            print(f"  {proto}: {count} ({percentage:.1f}%)")

class RawSocketCapture:
    def __init__(self):
        self.analyzer = PacketAnalyzer()
        self.running = False
    
    def create_raw_socket(self):
        """Create and configure raw socket"""
        try:
            # Create raw socket
            sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(0x0800))
            return sock
        except PermissionError:
            print("Permission denied. Try running with sudo/administrator privileges.")
            return None
        except Exception as e:
            print(f"Error creating socket: {e}")
            return None
    
    def parse_ethernet_header(self, data):
        """Parse Ethernet header"""
        dest_mac, src_mac, eth_proto = struct.unpack('! 6s 6s H', data[:14])
        return {
            'dest_mac': dest_mac.hex(':'),
            'src_mac': src_mac.hex(':'),
            'eth_proto': socket.htons(eth_proto)
        }
    
    def parse_ip_header(self, data):
        """Parse IP header"""
        version_ihl = data[0]
        version = version_ihl >> 4
        ihl = version_ihl & 0xF
        iph_length = ihl * 4
        
        ttl, protocol, checksum, src, dest = struct.unpack('! 8x B B H 4s 4s', data[:20])
        
        return {
            'version': version,
            'ihl': ihl,
            'ttl': ttl,
            'protocol': protocol,
            'src_ip': socket.inet_ntoa(src),
            'dest_ip': socket.inet_ntoa(dest),
            'header_length': iph_length
        }
    
    def capture_packets(self, interface=None, count=0):
        """Capture packets using raw socket"""
        sock = self.create_raw_socket()
        if not sock:
            return
        
        print("Starting raw socket packet capture...")
        print("Press Ctrl+C to stop")
        
        packet_counter = 0
        try:
            while True:
                if count > 0 and packet_counter >= count:
                    break
                
                # Receive packet
                raw_data, addr = sock.recvfrom(65536)
                
                # Parse Ethernet header
                eth = self.parse_ethernet_header(raw_data)
                
                # Parse IP header (assuming IPv4)
                if eth['eth_proto'] == 0x0800:  # IPv4
                    ip_data = raw_data[14:]  # Skip Ethernet header
                    ip = self.parse_ip_header(ip_data)
                    
                    print(f"\n[{datetime.now().strftime('%H:%M:%S')}] Packet #{packet_counter + 1}")
                    print(f"  Ethernet: {eth['src_mac']} -> {eth['dest_mac']}")
                    print(f"  IP: {ip['src_ip']} -> {ip['dest_ip']} (TTL: {ip['ttl']})")
                    print(f"  Protocol: {self.analyzer.get_protocol_name(ip['protocol'])}")
                    
                    # Parse transport layer based on protocol
                    if ip['protocol'] == 6:  # TCP
                        tcp_header = ip_data[ip['header_length']:ip['header_length']+20]
                        if len(tcp_header) >= 20:
                            src_port, dest_port = struct.unpack('! H H', tcp_header[:4])
                            print(f"  TCP: {src_port} -> {dest_port}")
                    elif ip['protocol'] == 17:  # UDP
                        udp_header = ip_data[ip['header_length']:ip['header_length']+8]
                        if len(udp_header) >= 8:
                            src_port, dest_port = struct.unpack('! H H', udp_header[:4])
                            print(f"  UDP: {src_port} -> {dest_port}")
                    
                    packet_counter += 1
                    
        except KeyboardInterrupt:
            print(f"\n\nCaptured {packet_counter} packets")
        finally:
            sock.close()

def scapy_capture(interface=None, count=0, filter_expr=""):
    """Capture packets using Scapy"""
    if not SCAPY_AVAILABLE:
        print("Scapy is not available. Please install it: pip install scapy")
        return
    
    analyzer = PacketAnalyzer()
    
    def packet_handler(packet):
        analyzer.analyze_scapy_packet(packet)
        # Stop after specified count if provided
        if count > 0 and analyzer.traffic_stats['total_packets'] >= count:
            return True
    
    print("Starting Scapy packet capture...")
    print("Press Ctrl+C to stop")
    
    try:
        sniff(iface=interface, prn=packet_handler, count=count, lfilter=lambda x: True)
    except KeyboardInterrupt:
        print("\nStopping capture...")
    except Exception as e:
        print(f"Error during capture: {e}")
    
    # Print final statistics
    analyzer.print_statistics()

def main():
    parser = argparse.ArgumentParser(description="Network Traffic Packet Capture Tool")
    parser.add_argument('--method', choices=['scapy', 'raw'], default='scapy',
                       help='Capture method (default: scapy)')
    parser.add_argument('--interface', '-i', help='Network interface to capture on')
    parser.add_argument('--count', '-c', type=int, default=0,
                       help='Number of packets to capture (0 = infinite)')
    parser.add_argument('--filter', '-f', default='',
                       help='BPF filter expression')
    parser.add_argument('--stats', action='store_true',
                       help='Show statistics only')
    
    args = parser.parse_args()
    
    print("Network Traffic Analyzer")
    print("=" * 40)
    print(f"Method: {args.method}")
    print(f"Interface: {args.interface or 'default'}")
    print(f"Count: {'infinite' if args.count == 0 else args.count}")
    print(f"Filter: {args.filter or 'none'}")
    print("=" * 40)
    
    if args.method == 'scapy':
        scapy_capture(args.interface, args.count, args.filter)
    else:
        raw_capture = RawSocketCapture()
        raw_capture.capture_packets(args.interface, args.count)

